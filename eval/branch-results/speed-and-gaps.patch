From 72ef27b7d7532e7f0d5f6dab2775e01b17184b49 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 11 Oct 2026 06:21:44 +0000
Subject: [PATCH 2/2] Spec doc: skipped_repeat_counts true only if the brief
 says a skipped step still counts, false if it says it is not a proposal;
 scorer applies dated code changes

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01KdXdkXwz4hnpWNsx5cadPC
---
 builder/spec_doc.md | 6 ++++--
 eval/score.py       | 8 +++++---
 2 files changed, 9 insertions(+), 5 deletions(-)

diff --git a/builder/spec_doc.md b/builder/spec_doc.md
index cc7bbc0..e0147e1 100644
--- a/builder/spec_doc.md
+++ b/builder/spec_doc.md
@@ -113,8 +113,10 @@ use the default shown and record it in `assumptions`.
                                                    // (omit when the brief has the agent offer the support transfer first)
            "promise_retries": null,               // only if the brief says how often a failed create_promise is retried
                                                    // (0 = never); unstated: once
-           "skipped_repeat_counts": null,         // only if the brief says whether a ladder step skipped because it would
-                                                   // repeat an earlier proposal still uses one of the band's proposals: true/false
+           "skipped_repeat_counts": null,         // a ladder step skipped because it would repeat an earlier proposal:
+                                                   // true ONLY if the brief says it still uses one of the band's proposals;
+                                                   // false if the brief says it is not a proposal / is not counted;
+                                                   // null (omit) if the brief says neither
            "week_end_today": null,                 // only if the brief says what a "last business day of this week" step
                                                    // means when today is that day: "next_week" (use next week's) or "today";
                                                    // omit when the brief is silent (the step is then read literally)
diff --git a/eval/score.py b/eval/score.py
index b8e8ff4..f194980 100644
--- a/eval/score.py
+++ b/eval/score.py
@@ -86,11 +86,11 @@ def answer(spec, c):
     events = spec.get("events") or {}
 
     def ev(sit):
+        if sit != "hardship" or not (events.get("transfer_support") or {}).get("queue"):
+            return engine.ev(sit)
         # the engine offers the brief's hardship transfer through the transfer_support event; when that event has a
         # queue, a hardship call ends there (transfer, its close codes, no other note)
-        if sit == "hardship" and (events.get("transfer_support") or {}).get("queue"):
-            return events["transfer_support"]
-        return events.get(sit) or {}
+        return engine.ev("transfer_support")
     if t == "deadline":
         _, p = facts(spec, i["now"], i["product"])
         return p["deadline"] if p["status"] == "open" else None
@@ -104,6 +104,8 @@ def answer(spec, c):
         return cal.is_business_day(cal.datetime.date.fromisoformat(i["date"]))
     if t == "callback_ok":
         return bool(engine.callback_ok({"now": i["now"]}, cal.datetime.date.fromisoformat(i["date"]), i["time"]))
+    if t in ("close", "note", "transfer"):                # a dated code change applies on the key's date, else after it
+        engine.TODAY[0] = cal.datetime.date.fromisoformat(i["now"][:10]) if i.get("now") else cal.datetime.date(2099, 1, 1)
     if t == "close":
         e = ev(i["situation"])
         return {"outcome": e.get("outcome"), "reason": e.get("reason") or ""}
