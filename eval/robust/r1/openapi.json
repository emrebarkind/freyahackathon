{
 "openapi": "3.0.3",
 "info": {
  "title": "Kestrel Mutual arrears tools",
  "version": "1.0",
  "description": "Mock of Kestrel Mutual's systems. Every call is written to the ledger the scorer reads. The service does not enforce the calling policy: it accepts a promise on a holiday or past a deadline. Following the policy and memos is the agent's job."
 },
 "servers": [
  {
   "url": "https://kestrel-mutual-mock.example.invalid/v1"
  }
 ],
 "components": {},
 "paths": {
  "/verify_identity": {
   "post": {
    "summary": "Check one security answer. Three wrong answers in total end the check.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         },
         "field": {
          "type": "string",
          "enum": [
           "dob",
           "postcode"
          ]
         },
         "answer": {
          "type": "string",
          "description": "For dob: DD/MM/YYYY with leading zeros, e.g. 07/03/1984. For postcode: capital letters and digits, no spaces, e.g. LS61AN. An unreadable value is rejected with ok=false and is not counted as a wrong answer."
         }
        },
        "required": [
         "customer_id",
         "field",
         "answer"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          },
          "passed": {
           "type": "boolean"
          },
          "wrong_left": {
           "type": "integer"
          },
          "identity_confirmed": {
           "type": "boolean"
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  },
  "/get_account": {
   "post": {
    "summary": "The overdue accounts. Refused until both questions are passed.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         }
        },
        "required": [
         "customer_id"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          },
          "accounts": {
           "type": "array",
           "items": {
            "type": "object",
            "properties": {
             "account_ref": {
              "type": "string"
             },
             "kind": {
              "type": "string",
              "enum": [
               "card",
               "loan",
               "overdraft"
              ]
             },
             "card_ending": {
              "type": "string",
              "description": "cards only"
             },
             "arrears": {
              "type": "number",
              "description": "overdue amount in pounds, e.g. 412.35"
             },
             "days_overdue": {
              "type": "integer"
             },
             "min_due": {
              "type": "number",
              "description": "cards only, pounds"
             },
             "repayment": {
              "type": "number",
              "description": "loans only, pounds"
             },
             "excess": {
              "type": "number",
              "description": "overdrafts only: amount over the agreed limit, pounds"
             }
            }
           }
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  },
  "/create_promise": {
   "post": {
    "summary": "Record a payment promise. One per account.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         },
         "account_ref": {
          "type": "string"
         },
         "amount_pence": {
          "type": "integer",
          "description": "The promised amount in pence (pounds x 100), e.g. 412.35 pounds is 41235."
         },
         "pay_date": {
          "type": "string",
          "format": "date"
         }
        },
        "required": [
         "customer_id",
         "account_ref",
         "amount_pence",
         "pay_date"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          },
          "promise_ref": {
           "type": "string"
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  },
  "/add_note": {
   "post": {
    "summary": "Record why an account ended the call without a promise.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         },
         "account_ref": {
          "type": "string"
         },
         "code": {
          "type": "string",
          "enum": [
           "refused",
           "hardship",
           "dispute",
           "paid"
          ]
         },
         "text": {
          "type": "string"
         }
        },
        "required": [
         "customer_id",
         "account_ref",
         "code"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  },
  "/schedule_callback": {
   "post": {
    "summary": "Book a callback.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         },
         "day": {
          "type": "string",
          "format": "date"
         },
         "at": {
          "type": "string",
          "description": "HH:MM, 24-hour"
         }
        },
        "required": [
         "customer_id",
         "day",
         "at"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  },
  "/transfer_to_agent": {
   "post": {
    "summary": "Hand the call to a person.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         },
         "queue": {
          "type": "string",
          "enum": [
           "arrangements",
           "general",
           "wellbeing"
          ]
         }
        },
        "required": [
         "customer_id",
         "queue"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  },
  "/close_call": {
   "post": {
    "summary": "End the call. Always the last tool call. Nothing is accepted after it.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         },
         "result": {
          "type": "string",
          "enum": [
           "promise",
           "paid",
           "transferred",
           "no_promise",
           "not_verified",
           "not_reached"
          ]
         },
         "reason": {
          "type": "string",
          "description": "Required for every result except promise and paid. See the table in the policy."
         }
        },
        "required": [
         "customer_id",
         "result"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  }
 }
}